              "value": "node"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "1"
            },
            {
              "name": "COSMOS_CONNECTION_STRING",
              "value": "[format('@Microsoft.KeyVault(VaultName={0};SecretName=CosmosConnectionString)', parameters('keyVaultName'))]"
            },
            {
              "name": "PUBSUB_CONNECTION_STRING",
              "value": "[format('@Microsoft.KeyVault(VaultName={0};SecretName=PubSubConnectionString)', parameters('keyVaultName'))]"
            },
            {
              "name": "HOUSEHOLD_ID",
              "value": "[parameters('householdId')]"
            },
            {
              "name": "AZURE_CLIENT_ID",
              "value": ""
            }
          ],
          "cors": {
