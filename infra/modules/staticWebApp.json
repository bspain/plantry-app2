    }
  },
  "parameters": {
    "name": {
      "type": "string",
      "metadata": {
        "description": "Azure Static Web Apps resource name (1–40 alphanumeric or hyphens)"
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region for the Static Web App.\nAllowed values: centralus, eastus2, eastasia, westeurope, westus2, southeastasia, northeurope, canadacentral, brazilsouth, koreacentral, australiaeast.\n"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2023-01-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Free",
        "tier": "Free"
      },
      "properties": {
        "buildProperties": {
          "appLocation": "apps/web",
          "outputLocation": "dist"
        }
      }
    }
  ],
  "outputs": {
    "name": {
      "type": "string",
      "value": "[parameters('name')]"
    },
    "defaultHostname": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/staticSites', parameters('name')), '2023-01-01').defaultHostname]"
    },
    "resourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/staticSites', parameters('name'))]"
    }
  }
}